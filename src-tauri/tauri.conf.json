{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "FlowUrja Studio",
  "identifier": "com.flowurja.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeExtensions": ["fus"],
            "CFBundleTypeName": "FlowUrja Studio Project",
            "CFBundleTypeRole": "Editor",
            "CFBundleTypeIconFile": "icon",
            "LSHandlerRank": "Owner"
          }
        ]
      },
      "dmg": {
        "background": "assets/dmg_background.png",
        "windowSize":  { "width": 660, "height": 400 },
        "appPosition": { "x": 170, "y": 160 },
        "applicationFolderPosition": { "x": 490, "y": 160 }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon":   "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode":     "both",
        "installerHooks":  "nsis/license_hook.nsh"
      }
    },
    "resources": {
      "sidecar/*": "sidecar",
      "resources/bin/*": "bin",
      "resources/lib/*": "lib",
      "resources/turbines/NREL-5MW": "turbines/NREL-5MW",
      "resources/turbines/IEA-10MW": "turbines/IEA-10MW",
      "resources/turbines/IEA-15MW-Mono": "turbines/IEA-15MW-Mono",
      "resources/turbines/IEA-15MW-UMaine": "turbines/IEA-15MW-UMaine",
      "resources/turbines/IEA-15MW-OLAF": "turbines/IEA-15MW-OLAF",
      "resources/turbines/IEA-22MW-Mono": "turbines/IEA-22MW-Mono",
      "resources/turbines/IEA-22MW-Semi": "turbines/IEA-22MW-Semi"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["fus"],
        "name": "FlowUrja Studio Project",
        "description": "FlowUrja Studio Project File"
      }
    ]
  }
}
